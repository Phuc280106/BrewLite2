@startuml

skinparam backgroundColor white

skinparam activity {
    BackgroundColor white
    BorderColor black
    BorderThickness 1.5
    FontColor black
    FontSize 14
    ArrowColor black
}

skinparam activityDiamond {
    BackgroundColor white
    BorderColor black
    BorderThickness 1.5
    FontColor black
}

skinparam partition {
    BorderColor black
    BackgroundColor white
    FontColor black
    FontSize 13
}

skinparam defaultFontColor black
skinparam ArrowColor black
skinparam ActivityBorderColor black
skinparam ActivityBackgroundColor white
skinparam PartitionBorderColor black
skinparam PartitionBackgroundColor white
skinparam shadowing false

start

' --- 1. LUỒNG ĐĂNG KÝ TÀI KHOẢN ---
if (Đã có tài khoản?) then ([Không - Cần đăng ký])
    partition "Người dùng" {
        :Nhập email và mật khẩu;
        :Nhấn "Đăng ký";
    }
    
    partition "Hệ thống" {
        :Kiểm tra định dạng mật khẩu (>= 8 ký tự)\nvà kiểm tra trùng lặp email;
        
        if (Mật khẩu hợp lệ?) then ([Hợp lệ])
            if (Email đã tồn tại trong hệ thống?) then ([Có - Trùng lặp])
                :Hiển thị thông báo lỗi:\n"Email này đã được sử dụng";
                stop
            else ([Không - Chưa tồn tại])
                :Băm mật khẩu bằng BCrypt;
                :Tạo tài khoản mới;
                :Thông báo đăng ký thành công;
                :Chuyển hướng tới trang "Đăng nhập";
            endif
        else ([Không hợp lệ])
            :Hiển thị thông báo lỗi mật khẩu không hợp lệ;
            stop
        endif
    }
else ([Có - Đã có tài khoản])
endif

' --- 2. LUỒNG ĐĂNG NHẬP & CẤP PHÁT JWT ---
partition "Người dùng" {
    :Nhập email và mật khẩu tại trang "Đăng nhập";
    :Nhấn "Đăng nhập";
}

partition "Hệ thống" {
    :Đối chiếu email và mật khẩu;
    
    if (Thông tin đăng nhập chính xác?) then ([Đúng])
        :Cấp phát JWT Access Token\n(có thời hạn hiệu lực);
        :Chuyển hướng về Trang chủ;
    else ([Sai email hoặc mật khẩu])
        :Từ chối đăng nhập;
        :Hiển thị thông báo lỗi:\n"Thông tin đăng nhập không chính xác";
        stop
    endif
}

' --- 3. LUỒNG TRUY CẬP TÀI NGUYÊN & XÁC THỰC JWT ---
partition "Người dùng" {
    :Yêu cầu truy cập tài nguyên dành cho thành viên\n(đính kèm JWT Access Token);
}

partition "Hệ thống" {
    :Kiểm tra sự tồn tại, chữ ký và thời hạn của JWT;
    
    if (Có JWT hợp lệ và còn hạn?) then ([Hợp lệ])
        :Cho phép truy cập tính năng thành viên;
    else ([Không có JWT / Sai chữ ký / Hết hạn])
        :Từ chối truy cập (401 Unauthorized);
        :Chuyển hướng về trang "Đăng nhập";
    endif
}

stop

@enduml