@startuml

skinparam backgroundColor white
skinparam sequence {
    ArrowColor #2C3E50
    LifeLineBorderColor #2C3E50
    LifeLineBorderThickness 1.5
    LifeLineBackgroundColor #EBF5FB
    ParticipantBorderColor #2980B9
    ParticipantBackgroundColor #EBF5FB
    ParticipantFontColor #1B4F72
    ActorBorderColor #2980B9
    ActorBackgroundColor #EBF5FB
    BoxBorderColor #2C3E50
    BoxBackgroundColor #FFFFFF
    MessageAlign center
    ResponseMessageBelowArrow true
}

autoactivate on

actor "Người dùng" as User
boundary "Màn hình Đăng ký" as RegisterUI
control "AuthController" as Controller
control "AuthService" as Service
control "UserRepository" as Repo
database "Cơ sở dữ liệu" as DB

User -> RegisterUI : Nhập email, mật khẩu (>= 8 ký tự)\nvà nhấn "Đăng ký"
RegisterUI -> Controller : register(email, password)
Controller -> Service : registerUser(email, password)
Service -> Repo : existsByEmail(email)
Repo -> DB : SELECT * FROM Users WHERE email = ?
DB --> Repo : Kết quả truy vấn
Repo --> Service : boolean (Tồn tại / Chưa tồn tại)

alt Email chưa tồn tại và mật khẩu hợp lệ (AC 1 - Đăng ký hợp lệ)
    Service -> Service : hashPasswordBCrypt(password)
    deactivate Service
    Service -> Repo : saveUser(email, hashedPassword)
    Repo -> DB : INSERT INTO Users(email, password_hash)
    DB --> Repo : Lưu thành công
    Repo --> Service : User entity
    Service --> Controller : Kết quả đăng ký thành công
    Controller --> RegisterUI : 201 Created (Đăng ký thành công)
    RegisterUI --> User : Thông báo thành công &\nChuyển hướng tới trang "Đăng nhập"
else Email đã tồn tại trong hệ thống (AC 2 - Đăng ký trùng lặp)
    Service --> Controller : Lỗi trùng lặp email
    Controller --> RegisterUI : 400 Bad Request ("Email này đã được sử dụng")
    RegisterUI --> User : Hiển thị lỗi "Email này đã được sử dụng"
end

@enduml