@startuml

skinparam backgroundColor white
skinparam sequence {
    ArrowColor #2C3E50
    LifeLineBorderColor #2C3E50
    LifeLineBorderThickness 1.5
    LifeLineBackgroundColor #EBF5FB
    ParticipantBorderColor #2980B9
    ParticipantBackgroundColor #EBF5FB
    ParticipantFontColor #1B4F72
    ActorBorderColor #2980B9
    ActorBackgroundColor #EBF5FB
    BoxBorderColor #2C3E50
    BoxBackgroundColor #FFFFFF
    MessageAlign center
    ResponseMessageBelowArrow true
}

autoactivate on

actor "Người dùng" as User
boundary "Màn hình Đăng ký" as RegisterUI
control "AuthController" as Controller
control "AuthService" as Service
database "Cơ sở dữ liệu" as DB

User -> RegisterUI : Nhập họ tên, email (@gmail.com) và mật khẩu (>= 6 ký tự)\nvà nhấn "Đăng ký"
RegisterUI -> Controller : register(name, email, password)
Controller -> Service : register(dto)

alt Email không có đuôi @gmail.com
    Service --> Controller : BadRequestException
    Controller --> RegisterUI : 400 Bad Request ("Hệ thống chỉ chấp nhận địa chỉ email có đuôi @gmail.com...")
    RegisterUI --> User : Hiển thị lỗi định dạng @gmail.com
else Email hợp lệ (@gmail.com)
    Service -> DB : prisma.user.findUnique(email)
    DB --> Service : Dữ liệu User (hoặc null)

    alt Email chưa tồn tại (AC 1 - Đăng ký hợp lệ)
        Service -> Service : bcrypt.hash(password, 10)
        deactivate Service
        Service -> DB : prisma.user.create(name, email, passwordHash, role: 'CUSTOMER')\n+ tạo ví loyalty (10 điểm chào mừng, EARN)
        DB --> Service : Lưu thành công (User entity)
        Service --> Controller : { message: "Đăng ký thành công", user }
        Controller --> RegisterUI : 201 Created (Đăng ký thành công)
        RegisterUI --> User : Thông báo thành công &\nChuyển hướng tới trang "Đăng nhập"
    else Email đã tồn tại trong hệ thống (AC 2 - Đăng ký trùng lặp)
        Service --> Controller : ConflictException
        Controller --> RegisterUI : 409 Conflict ("Email này đã được sử dụng")
        RegisterUI --> User : Hiển thị lỗi "Email này đã được sử dụng"
    end
end

@enduml