@startuml

skinparam backgroundColor white
skinparam sequence {
    ArrowColor #2C3E50
    LifeLineBorderColor #2C3E50
    LifeLineBorderThickness 1.5
    LifeLineBackgroundColor #EBF5FB
    ParticipantBorderColor #2980B9
    ParticipantBackgroundColor #EBF5FB
    ParticipantFontColor #1B4F72
    ActorBorderColor #2980B9
    ActorBackgroundColor #EBF5FB
    BoxBorderColor #2C3E50
    BoxBackgroundColor #FFFFFF
    MessageAlign center
    ResponseMessageBelowArrow true
}

' Tự động hiển thị thanh kích hoạt (Activation Bar) dọc theo đường Lifeline
autoactivate on

actor "Người dùng" as User
boundary "Giao diện Người dùng" as UI
control "Auth & Member\nController" as Controller
control "Auth & JWT\nService" as Service
control "UserRepository" as Repo
database "Cơ sở dữ liệu" as DB

' ==========================================================
' 1. LUỒNG ĐĂNG KÝ TÀI KHOẢN (AC 1 & AC 2)
' ==========================================================
== 1. Đăng ký tài khoản ==

User -> UI : Nhập email, mật khẩu (>= 8 ký tự)\nvà nhấn "Đăng ký"
UI -> Controller : register(email, password)
Controller -> Service : registerUser(email, password)
Service -> Repo : existsByEmail(email)
Repo -> DB : SELECT * FROM Users WHERE email = ?
DB --> Repo : Kết quả truy vấn
Repo --> Service : boolean (Tồn tại / Chưa tồn tại)

alt Email chưa tồn tại và mật khẩu hợp lệ (AC 1 - Đăng ký hợp lệ)
    Service -> Service : hashPasswordBCrypt(password)
    deactivate Service
    Service -> Repo : saveUser(email, hashedPassword)
    Repo -> DB : INSERT INTO Users(email, password_hash)
    DB --> Repo : Lưu thành công
    Repo --> Service : User entity
    Service --> Controller : Kết quả đăng ký thành công
    Controller --> UI : 201 Created (Đăng ký thành công)
    UI --> User : Thông báo thành công &\nChuyển hướng tới trang "Đăng nhập"
else Email đã tồn tại trong hệ thống (AC 2 - Đăng ký trùng lặp)
    Service --> Controller : Lỗi trùng lặp email
    Controller --> UI : 400 Bad Request ("Email này đã được sử dụng")
    UI --> User : Hiển thị lỗi "Email này đã được sử dụng"
end

' ==========================================================
' 2. LUỒNG ĐĂNG NHẬP & CẤP PHÁT JWT (AC 3 & AC 4)
' ==========================================================
== 2. Đăng nhập & Cấp phát JWT ==

User -> UI : Nhập email, mật khẩu\nvà nhấn "Đăng nhập"
UI -> Controller : login(email, password)
Controller -> Service : authenticate(email, password)
Service -> Repo : findByEmail(email)
Repo -> DB : SELECT * FROM Users WHERE email = ?
DB --> Repo : Dữ liệu User (hoặc null)
Repo --> Service : User entity (hoặc null)

alt Email tồn tại và khớp mật khẩu BCrypt (AC 3 - Đăng nhập thành công)
    Service -> Service : verifyBCrypt(password, password_hash)
    deactivate Service
    Service -> Service : generateJwtAccessToken(user)
    deactivate Service
    Service --> Controller : JWT Access Token (có thời hạn hiệu lực)
    Controller --> UI : 200 OK (JWT Access Token)
    UI --> User : Lưu phiên đăng nhập &\nChuyển hướng về Trang chủ
else Sai email hoặc sai mật khẩu (AC 4 - Đăng nhập thất bại)
    Service --> Controller : Xác thực thất bại
    Controller --> UI : 401 Unauthorized ("Thông tin đăng nhập không chính xác")
    UI --> User : Từ chối đăng nhập & Hiển thị lỗi\n"Thông tin đăng nhập không chính xác"
end

' ==========================================================
' 3. LUỒNG XÁC THỰC JWT KHI TRUY CẬP TÀI NGUYÊN (AC 5)
' ==========================================================
== 3. Xác thực phiên làm việc bằng JWT ==

User -> UI : Truy cập tính năng dành cho thành viên
UI -> Controller : accessProtectedResource(JWT Access Token)
Controller -> Service : validateJwtToken(JWT Access Token)

alt Đính kèm JWT hợp lệ và còn hạn (AC 5.1)
    Service -> Service : Kiểm tra chữ ký và thời hạn (exp)
    deactivate Service
    Service --> Controller : Token hợp lệ (User Claims)
    Controller --> UI : 200 OK (Dữ liệu tài nguyên thành viên)
    UI --> User : Cho phép truy cập tính năng thành viên
else Không có JWT, sai chữ ký hoặc đã hết hạn (AC 5.2)
    Service -> Service : Kiểm tra chữ ký và thời hạn (exp)
    deactivate Service
    Service --> Controller : Token không hợp lệ / Hết hạn
    Controller --> UI : 401 Unauthorized (Từ chối truy cập)
    UI --> User : Từ chối truy cập &\nChuyển hướng về trang "Đăng nhập"
end

@enduml