@startuml usecase-menu
left to right direction
skinparam packageStyle rectangle

actor "Khách hàng" as KhachHang

rectangle "Hệ thống BrewLite - Hiển thị menu & Lọc theo danh mục" {
  usecase "Xem menu" as XemMenu
  usecase "Xem chi tiết món" as XemChiTiet
  usecase "Lọc theo danh mục" as LocDanhMuc
  usecase "Tìm kiếm món" as TimKiem
}

KhachHang -- XemMenu

XemMenu <.. XemChiTiet : <<extend>>
XemMenu <.. LocDanhMuc : <<extend>>
XemMenu <.. TimKiem : <<extend>>

@enduml