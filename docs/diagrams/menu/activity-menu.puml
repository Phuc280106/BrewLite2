@startuml activity-menu
title Sơ đồ activity chức năng Hiển thị menu & Lọc theo danh mục (FR-01, FR-02)

' Cấu hình để hình thoi gộp nhánh và rẽ nhánh chuẩn UML (trống bên trong)
skinparam ConditionEndStyle hline

|Khách hàng|
start
:Mở trang Menu;

repeat
  |Hệ thống|
  :Hiển thị trạng thái Loading (Skeleton);
  :Gửi GET /api/v1/products\n(kèm category, search nếu có);
  :API kiểm tra tham số\nvà truy vấn cơ sở dữ liệu;

  if () then (Yêu cầu thành công)
    if () then (Có món phù hợp)
      :Hiển thị thanh danh mục\nvà danh sách món;
    else (Không có món phù hợp)
      :Hiển thị trạng thái Empty;
    endif
  else (Lỗi tham số / lỗi server)
    :Hiển thị trạng thái Error\nkèm nút "Thử lại";
  endif

  |Khách hàng|
  :Chọn thao tác tiếp theo;
repeat while () is (Lọc danh mục / Tìm kiếm / Thử lại) not (Không)

if () then (Chọn xem chi tiết một món)
  |Hệ thống|
  :Gửi GET /api/v1/products/:id;
  if () then (Tìm thấy món)
    :Hiển thị chi tiết món;
  else (Không tìm thấy - 404)
    :Báo "Không tìm thấy món"\nvà quay về menu;
  endif
else (Không xem chi tiết)
endif

|Khách hàng|
stop
@enduml