@startuml activity-menu
skinparam ConditionEndStyle hline
title Sơ đồ Activity: Hiển thị menu & Lọc theo danh mục (FR-01, FR-02)

|Khách hàng|
start
:Mở trang Thực đơn (Menu);

|Hệ thống|
repeat
  :Hiển thị trạng thái đang tải (Skeleton);
  :Tiếp nhận yêu cầu lấy danh sách món\n(kèm điều kiện lọc danh mục, từ khóa nếu có);
  :Kiểm tra tính hợp lệ của điều kiện lọc\nvà truy vấn danh sách món ăn;

  if () then (Có món ăn phù hợp)
    :Hiển thị thanh danh mục\nvà danh sách món ăn;
  elseif () then (Không có món phù hợp)
    :Hiển thị trạng thái danh sách trống (Empty);
  else (Tham số không hợp lệ / Lỗi hệ thống)
    :Hiển thị thông báo lỗi (Error)\nkèm nút "Thử lại";
  endif

|Khách hàng|
  :Chọn thao tác tiếp theo;
repeat while () is (Lọc danh mục / Tìm kiếm / Thử lại) not (Không)

if () then (Chọn xem chi tiết một món)
  |Hệ thống|
  :Truy vấn thông tin chi tiết món ăn đã chọn;
  if () then (Tìm thấy thông tin món)
    :Hiển thị thông tin chi tiết món ăn;
  else (Món không tồn tại)
    :Thông báo "Không tìm thấy món"\nvà điều hướng quay về trang Thực đơn;
  endif
else (Kết thúc duyệt thực đơn)
endif

|Khách hàng|
stop
@enduml