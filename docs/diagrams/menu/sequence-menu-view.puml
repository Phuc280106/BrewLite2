@startuml sequence-menu-list
title Sequence Diagram - Luồng 1: Xem thực đơn đồ uống (FR-01)
skinparam sequenceMessageAlign left
skinparam monochrome true
skinparam shadowing false
skinparam ParticipantBackgroundColor white
skinparam ActorBackgroundColor white
hide footbox
autonumber "0: "

actor "__: KhachHang__" as KH
participant "__:ManHinhMenu__" as UI
participant "__:ProductsController__" as CTRL
participant "__:ProductsService__" as SVC
participant "__:PrismaService__" as PRISMA
participant "__:PostgreSQL__" as DB

KH -> UI : moTrangThucDon()
activate UI
UI --> KH : hienThiTrangThaiLoading()
UI -> CTRL : layDanhSachSanPham()
activate CTRL
CTRL -> SVC : layDanhSachSanPham(query)
activate SVC
SVC -> PRISMA : timTatCaSanPham()
activate PRISMA
PRISMA -> DB : truyVanDanhSachSanPham()
activate DB

alt Truy vấn thành công và có sản phẩm
    DB --> PRISMA : cacBanGhiSanPham
    PRISMA --> SVC : danhSachSanPham
    SVC --> CTRL : danhSachSanPham
    CTRL --> UI : danhSachSanPham
    UI --> KH : hienThiDanhMucVaDanhSachMon(danhSachSanPham)
else Truy vấn thành công nhưng danh sách rỗng
    DB --> PRISMA : khongCoBanGhi
    PRISMA --> SVC : danhSachRong
    SVC --> CTRL : danhSachRong
    CTRL --> UI : danhSachRong
    UI --> KH : hienThiTrangThaiEmpty()
else Lỗi truy vấn hoặc mất kết nối cơ sở dữ liệu
    DB --> PRISMA : loiTruyVan
    PRISMA --> SVC : loiCoSoDuLieu
    SVC --> CTRL : loiXuLyDuLieu
    CTRL --> UI : loiHeThong
    UI --> KH : hienThiTrangThaiError(nutThuLai)
end
deactivate DB
deactivate PRISMA
deactivate SVC
deactivate CTRL
deactivate UI
@enduml
