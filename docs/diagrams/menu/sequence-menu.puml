@startuml sequence-menu
title Sơ đồ sequence chức năng Hiển thị menu & Lọc theo danh mục (FR-01, FR-02)
autonumber

actor "Khách hàng" as KH
boundary "Màn hình Menu\n(Next.js)" as UI
control "ProductsController\n(NestJS)" as PC
control "ProductsService\n(NestJS)" as PS
control "PrismaService\n(Prisma ORM)" as PR
database "PostgreSQL" as DB

== Luồng 1: Xem menu (FR-01) ==
KH -> UI : Mở trang Menu
activate UI
UI --> KH : Hiển thị trạng thái Loading (Skeleton)
UI -> PC : GET /api/v1/products
activate PC
PC -> PS : findAll(query)
activate PS
PS -> PR : product.findMany(include category)
activate PR
PR -> DB : SELECT ... FROM Product JOIN Category
activate DB
alt Truy vấn thành công và có món
  DB --> PR : Các bản ghi sản phẩm
  PR --> PS : Danh sách Product
  PS --> PC : Danh sách món
  PC --> UI : 200 OK (mảng món)
  UI --> KH : Hiển thị thanh danh mục và danh sách món
else Truy vấn thành công nhưng không có món
  DB --> PR : Không có bản ghi
  PR --> PS : Mảng rỗng
  PS --> PC : Mảng rỗng
  PC --> UI : 200 OK (mảng rỗng)
  UI --> KH : Hiển thị trạng thái Empty
else Lỗi server hoặc mất kết nối CSDL
  DB --> PR : Lỗi truy vấn
  PR --> PS : Exception
  PS --> PC : Exception
  PC --> UI : 500 Internal Server Error
  UI --> KH : Hiển thị trạng thái Error kèm nút "Thử lại"
end
deactivate DB
deactivate PR
deactivate PS
deactivate PC
deactivate UI
note over UI : Khi khách bấm "Thử lại",\nluồng 1 được thực hiện lại.

== Luồng 2: Lọc theo danh mục / Tìm kiếm (FR-02) ==
KH -> UI : Chọn danh mục hoặc nhập từ khóa
activate UI
UI --> KH : Hiển thị trạng thái Loading
UI -> PC : GET /api/v1/products?category=...&search=...
activate PC
PC -> PC : ValidationPipe kiểm tra QueryProductDto
alt Tham số không hợp lệ
  PC --> UI : 400 Bad Request
  UI --> KH : Hiển thị trạng thái Error
else Tham số hợp lệ
  PC -> PS : findAll(query)
  activate PS
  PS -> PR : product.findMany(where category, name chứa từ khóa)
  activate PR
  PR -> DB : SELECT ... WHERE category = ? AND name ILIKE ?
  activate DB
  DB --> PR : Các bản ghi khớp điều kiện
  deactivate DB
  PR --> PS : Danh sách Product
  deactivate PR
  PS --> PC : Danh sách món
  deactivate PS
  alt Có món khớp
    PC --> UI : 200 OK (mảng món)
    UI --> KH : Cập nhật danh sách món
  else Không có món khớp
    PC --> UI : 200 OK (mảng rỗng)
    UI --> KH : Hiển thị trạng thái Empty
  end
end
deactivate PC
deactivate UI

== Luồng 3: Xem chi tiết món (FR-01) ==
KH -> UI : Chọn một món
activate UI
UI -> PC : GET /api/v1/products/:id
activate PC
PC -> PS : findOne(id)
activate PS
PS -> PR : product.findUnique(id)
activate PR
PR -> DB : SELECT ... FROM Product WHERE id = ?
activate DB
alt Tìm thấy món
  DB --> PR : Bản ghi sản phẩm
  PR --> PS : Product
  PS --> PC : Chi tiết món
  PC --> UI : 200 OK (chi tiết món)
  UI --> KH : Hiển thị chi tiết món
else Không tìm thấy món
  DB --> PR : Không có bản ghi
  PR --> PS : null
  PS --> PC : NotFoundException
  PC --> UI : 404 Not Found
  UI --> KH : Báo "Không tìm thấy món" và quay về menu
end
deactivate DB
deactivate PR
deactivate PS
deactivate PC
deactivate UI
@enduml
