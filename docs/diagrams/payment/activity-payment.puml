@startuml
title Sơ đồ activity chức năng Thanh toán qua Cổng VNPay Sandbox\n& Chống trùng lặp (FR-06)

skinparam defaultFontSize 11
skinparam titleFontSize 12
skinparam Padding 1
skinparam ConditionStyle diamond
skinparam ConditionEndStyle diamond
skinparam ActivityPadding 4
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #2C3E50
skinparam ArrowColor #2C3E50
skinparam ActivityDiamondBackgroundColor #FEF9E7
skinparam ActivityDiamondBorderColor #B7950B
skinparam swimlaneTitleFontStyle bold
skinparam NoteBackgroundColor #FEF9E7

|Khách hàng|
start
:Chọn phương thức VNPay\n(Cổng VNPay / QR / ATM / Thẻ quốc tế);
:Nhấn nút "Thanh toán qua VNPay";

|Hệ thống|
:Khóa nút, gửi POST /payments/initiate\nkèm JWT + mã đơn;

-> JWT hợp lệ?;
if () then (không)
  :Trả lỗi 401;
  stop
else (có)
endif

-> Đơn hợp lệ, PENDING,\nchưa quá 15 phút và từ 5.000đ?;
if () then (không)
  :Từ chối,\nđơn không hợp lệ;
  stop
else (có)
endif

:Sinh vnp_TxnRef (orderId_timestamp),\nký HMAC-SHA512, trả paymentUrl;
:Chuyển hướng khách\nsang Cổng VNPay;

|Cổng VNPay|
:Khách thanh toán trên cổng\n(hoặc bấm Hủy);
:Chuyển khách về ReturnUrl\nkèm tham số vnp_*;

|Hệ thống|
:Trang /payment/vnpay-return gọi\nGET /payments/vnpay/return;

-> Chữ ký hợp lệ?;
if () then (không)
  :Từ chối (400),\nkhông đổi dữ liệu;
  stop
else (có)
endif

-> vnp_TxnRef đã\nxử lý trước đó?;
if () then (có)
  :Trả kết quả cũ (200 OK),\nkhông ghi thêm, không cộng điểm lần 2;
else (chưa)
  -> Đơn tồn tại và số tiền\nkhớp giá trị đơn?;
  if () then (không)
    :Từ chối (400),\nkhông ghi nhận giao dịch;
    stop
  else (có)
  endif

  -> VNPay báo\nthành công (00)?;
  if () then (thành công)
    :Tạo Payment SUCCESS,\nđơn PENDING → PREPARING,\ncộng điểm thưởng;
  else (thất bại / khách hủy)
    :Tạo Payment FAILED,\ngiữ đơn PENDING;

    |Khách hàng|
    :Xem lỗi, chọn\n"Thanh toán lại";
    stop
  endif
endif

|Hệ thống|
:Hiển thị kết quả thành công,\nchuyển sang màn hình Biên nhận;

|Khách hàng|
:Xem biên nhận đơn hàng;
stop

note right
  Ngoài luồng: quá 15 phút chưa
  thanh toán thành công thì hệ thống
  hoàn kho, đơn chuyển CANCELLED.
end note
@enduml
