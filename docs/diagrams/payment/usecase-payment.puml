@startuml
left to right direction

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #2C3E50
    BorderThickness 1.5
    FontSize 13
}
skinparam actor {
    BackgroundColor #EBF5FB
    BorderColor #2980B9
}
skinparam rectangle {
    BorderColor #2C3E50
}
skinparam ArrowColor #2C3E50

title Sơ đồ use case chức năng Thanh toán qua Cổng VNPay Sandbox & Chống trùng lặp (FR-06)

actor "Khách hàng" as Customer
actor "Cổng VNPay\nSandbox" as Gateway

rectangle "Phân hệ Thanh toán & Giao dịch (Payment & Transaction Module)" {
    usecase "Thanh toán đơn hàng" as UC_Pay

    usecase "Chọn phương thức thanh toán VNPay\n(Cổng VNPay Sandbox / ATM / Thẻ quốc tế)" as UC_Method
    usecase "Sinh URL thanh toán VNPay\n(vnp_TxnRef + chữ ký HMAC-SHA512)" as UC_CreateUrl
    usecase "Xác minh chữ ký ReturnUrl" as UC_Verify
    usecase "Kiểm tra giao dịch đã xử lý\n(khóa theo vnp_TxnRef)" as UC_CheckKey
    usecase "Cập nhật trạng thái\nthanh toán & đơn hàng" as UC_Update

    usecase "Trả về kết quả giao dịch cũ\n(không ghi nhận lần 2)" as UC_Replay
    usecase "Xử lý thanh toán thất bại / khách hủy\n(Payment = FAILED)" as UC_Fail
    usecase "Hủy đơn & hoàn kho\nkhi quá 15 phút" as UC_Timeout
}

Customer -- UC_Pay
UC_Fail -[hidden]right- Gateway
UC_CreateUrl -- Gateway
UC_Verify -- Gateway

UC_Pay ..> UC_Method : <<include>>
UC_Pay ..> UC_CreateUrl : <<include>>
UC_Pay ..> UC_Verify : <<include>>
UC_Pay ..> UC_CheckKey : <<include>>
UC_Pay ..> UC_Update : <<include>>

UC_Replay .left.> UC_CheckKey : <<extend>>\n[vnp_TxnRef đã xử lý]
UC_Fail .left.> UC_Verify : <<extend>>\n[VNPay báo thất bại / khách hủy]
UC_Timeout .up.> UC_Pay : <<extend>>\n[quá 15 phút chưa thanh toán]

@enduml
