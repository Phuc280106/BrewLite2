@startuml
title Sequence Diagram - Thanh toán mô phỏng & Chống trùng lặp (FR-06)

autonumber "0:"
hide footbox

skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 5
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 15
skinparam sequence {
    ParticipantBackgroundColor white
    ParticipantBorderColor #333333
    ActorBackgroundColor white
    ActorBorderColor #333333
    LifeLineBorderColor #888888
    LifeLineBackgroundColor white
    ArrowColor black
    GroupBorderThickness 2
}

actor "<u>: KhachHang</u>" as User
participant "<u>:CheckoutPage</u>" as UI
participant "<u>:PaymentsController</u>" as Controller
participant "<u>:JwtAuthGuard</u>" as Guard
participant "<u>:PaymentsService</u>" as Service
participant "<u>:MockPaymentGateway</u>" as Gateway
participant "<u>:PrismaService</u>" as Prisma
participant "<u>:PostgreSQL</u>" as DB

User -> UI : selectMethod(method)
activate UI
UI -> UI : generateIdempotencyKey()
User -> UI : onClickPay()
UI -> UI : disablePayButton()
UI -> Controller : createPayment(orderId, method, key)
activate Controller
Controller -> Guard : canActivate(context)
activate Guard
Guard --> Controller : userId
deactivate Guard

alt Thiếu JWT hoặc thiếu Idempotency-Key
    Controller --> UI : invalidRequestError
    UI --> User : showError(message)
else JWT hợp lệ và có Idempotency-Key
    Controller -> Service : processPayment(userId, orderId, method, key)
    activate Service
    Service -> Prisma : findPaymentByKey(key, userId)
    activate Prisma
    Prisma -> DB : queryPaymentByKey(key, userId)
    activate DB
    DB --> Prisma : paymentRecord
    deactivate DB
    Prisma --> Service : payment
    deactivate Prisma

    alt Key đã tồn tại
        alt Payment cũ là SUCCESS
            Service --> Controller : payment
            Controller --> UI : paymentResponse
            UI --> User : navigateToReceipt(orderId)
        else Payment cũ là FAILED
            Service --> Controller : payment
            Controller --> UI : paymentError
            UI --> User : showError(message)
            UI -> UI : generateIdempotencyKey()
        end
    else Key chưa tồn tại
        Service -> Prisma : findOrder(orderId)
        activate Prisma
        Prisma -> DB : queryOrderById(orderId)
        activate DB
        DB --> Prisma : orderRecord
        deactivate DB
        Prisma --> Service : order
        deactivate Prisma
        Service -> Service : validateOrder(order, userId)

        alt Đơn không hợp lệ
            Service --> Controller : InvalidOrderException
            Controller --> UI : invalidOrderError
            UI --> User : showError(message)
        else Đơn hợp lệ
            Service -> Gateway : charge(amount, method)
            activate Gateway
            Gateway --> Service : gatewayResult
            deactivate Gateway

            alt Giao dịch thành công
                Service -> Prisma : saveSuccessPaymentAndMarkPreparing(order, key, method)
                activate Prisma
                Prisma -> DB : insertPaymentAndUpdateOrder(order, key, method)
                activate DB
                DB --> Prisma : paymentRecord
                deactivate DB
                Prisma --> Service : payment
                deactivate Prisma
                Service --> Controller : payment
                Controller --> UI : paymentResponse
                UI --> User : navigateToReceipt(orderId)
            else Giao dịch bị từ chối
                Service -> Prisma : saveFailedPayment(order, key, method)
                activate Prisma
                Prisma -> DB : insertPayment(order, key, method)
                activate DB
                DB --> Prisma : paymentRecord
                deactivate DB
                Prisma --> Service : payment
                deactivate Prisma
                Service --> Controller : payment
                Controller --> UI : paymentError
                UI --> User : showError(message)
                UI -> UI : generateIdempotencyKey()
            end
        end
    end
    deactivate Service
end
deactivate Controller
deactivate UI

@enduml
