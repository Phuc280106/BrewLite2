@startuml
title Sequence Diagram - Hủy đơn & hoàn kho khi quá 15 phút chưa thanh toán (FR-06)

autonumber 1 1 "0:  "
skinparam backgroundColor white
skinparam sequenceMessageAlign left
skinparam sequence {
    ArrowColor black
    LifeLineBorderColor black
    ParticipantBorderColor black
    ParticipantBackgroundColor white
    ParticipantFontColor black
}

<style>
participant {
    Padding 20
}
</style>

participant "<u>:OrderExpiryScheduler</u>" as Scheduler
participant "<u>:OrdersService</u>" as Service
participant "<u>:PrismaService</u>" as Prisma
participant "<u>:PostgreSQL</u>" as DB

loop [. mỗi phút]
    Scheduler -> Service : huyDonQuaHan()
    activate Service
    Service -> Prisma : timDonChoThanhToanQuaHan()
    activate Prisma
    Prisma -> DB : truyVanDonQuaHan()
    activate DB
    DB --> Prisma : danhSachBanGhi
    deactivate DB
    Prisma --> Service : danhSachDonQuaHan
    deactivate Prisma

    loop [. với mỗi đơn quá hạn]
        Service -> Prisma : batDauGiaoDich()
        activate Prisma
        Prisma -> DB : BEGIN
        activate DB
        Service -> Prisma : hoanKhoNguyenLieu(donHang)
        Prisma -> DB : capNhatTonKho()
        DB --> Prisma : ketQuaCapNhatKho
        Service -> Prisma : capNhatTrangThaiDon(CANCELLED)
        Prisma -> DB : capNhatTrangThai()
        DB --> Prisma : ketQuaCapNhatDon
        Service -> Prisma : xacNhanGiaoDich()
        Prisma -> DB : COMMIT
        DB --> Prisma : daXacNhan
        deactivate DB
        Prisma --> Service : daHuyDonVaHoanKho
        deactivate Prisma
    end
    deactivate Service
end

@enduml